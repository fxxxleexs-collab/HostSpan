+def test_project_env_file_is_loaded(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("MINI_AGENT_PROVIDER", raising=False)
+    monkeypatch.delenv("MINI_AGENT_MODEL", raising=False)
+    monkeypatch.delenv("MINI_AGENT_API_KEY", raising=False)
+    (tmp_path / ".env").write_text(
+        """
+MINI_AGENT_PROVIDER=anthropic
+MINI_AGENT_MODEL=claude-from-env-file
+MINI_AGENT_API_KEY="from env file"
+MINI_AGENT_MAX_ITERATIONS=11
+MINI_AGENT_RUNTIME_MODE=ssh
+MINI_AGENT_SSH_HOST=env-file-host
+MINI_AGENT_SSH_USER=envrt
+MINI_AGENT_SSH_PORT=2201
+MINI_AGENT_REMOTE_ROOT=.environment-runtime/project
+""",
+        encoding="utf-8",
+    )
+
+    config = load_harness_config(project_root=str(tmp_path))
+
+    assert config.model.provider == "anthropic"
+    assert config.model.model == "claude-from-env-file"
+    assert config.model.api_key == "from env file"
+    assert config.agent.max_iterations == 11
+    assert config.runtime.mode == "ssh"
+    assert config.runtime.ssh.hostname == "env-file-host"
+    assert config.runtime.ssh.username == "envrt"
+    assert config.runtime.ssh.port == 2201
+    assert config.runtime.ssh.remote_root == ".environment-runtime/project"
+
+
+def test_project_env_file_does_not_override_existing_env(
