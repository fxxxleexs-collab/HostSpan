+                "MINI_AGENT_MAX_CONTEXT_CHARS", config.max_context_chars
+            ),
+            "max_tool_result_chars": _env_int(
+                "MINI_AGENT_MAX_TOOL_RESULT_CHARS", config.max_tool_result_chars
+            ),
+            "recent_tool_turns": _env_int(
+                "MINI_AGENT_RECENT_TOOL_TURNS", config.recent_tool_turns
+            ),
+            "auto_compact_turns": _env_int(
+                "MINI_AGENT_AUTO_COMPACT_TURNS", config.auto_compact_turns
+            ),
+            "auto_compact_tool_turns": _env_int(
+                "MINI_AGENT_AUTO_COMPACT_TOOL_TURNS", config.auto_compact_tool_turns
+            ),
+            "tool_timeout_seconds": _env_float(
+                "MINI_AGENT_TOOL_TIMEOUT_SECONDS", config.tool_timeout_seconds
+            ),
+            "task_observe_poll_seconds": _env_float(
+                "MINI_AGENT_TASK_OBSERVE_POLL_SECONDS",
+                config.task_observe_poll_seconds,
+            ),
+            "allow_unguarded_write": _env_bool(
+                "MINI_AGENT_ALLOW_UNGUARDED_WRITE", config.allow_unguarded_write
+            ),
+        }
+    )
+
+
+def _permissions_from_env(config: PermissionsConfig) -> PermissionsConfig:
+    return config.model_copy(
+        update={
+            "allow": _env_csv("MINI_AGENT_PERMISSIONS_ALLOW", config.allow),
+            "deny": _env_csv("MINI_AGENT_PERMISSIONS_DENY", config.deny),
+            "approve_sandbox_denials": _env_bool(
+                "MINI_AGENT_APPROVE_SANDBOX_DENIALS", config.approve_sandbox_denials
+            ),
+            "approve_terminal_open": _env_bool(
+                "MINI_AGENT_APPROVE_TERMINAL_OPEN", config.approve_terminal_open
+            ),
+        }
+    )
+
+
+def _sandbox_from_env(config: SandboxConfig) -> SandboxConfig:
+    local = _sandbox_target_from_env(config.local, "LOCAL")
+    remote = _sandbox_target_from_env(config.remote, "REMOTE")
+    paths = config.paths.model_copy(
+        update={
+            "allow": _env_csv("MINI_AGENT_SANDBOX_PATHS_ALLOW", config.paths.allow),
+            "deny": _env_csv("MINI_AGENT_SANDBOX_PATHS_DENY", config.paths.deny),
+        }
+    )
+    return config.model_copy(
+        update={
+            "profile": os.getenv("MINI_AGENT_SANDBOX_PROFILE") or config.profile,
+            "engine": os.getenv("MINI_AGENT_SANDBOX_ENGINE") or config.engine,
+            "local": local,
+            "remote": remote,
+            "paths": paths,
+        }
+    )
+
+
+def _sandbox_target_from_env(config: SandboxTargetConfig, prefix: str) -> SandboxTargetConfig:
+    return config.model_copy(
+        update={
+            "root": os.getenv(f"MINI_AGENT_SANDBOX_{prefix}_ROOT") or config.root,
+            "engine": os.getenv(f"MINI_AGENT_SANDBOX_{prefix}_ENGINE") or config.engine,
+            "require_engine": _env_bool(
+                f"MINI_AGENT_SANDBOX_{prefix}_REQUIRE_ENGINE", config.require_engine
+            ),
+            "network": os.getenv(f"MINI_AGENT_SANDBOX_{prefix}_NETWORK") or config.network,
+            "allow_root_shell": _env_bool(
+                f"MINI_AGENT_SANDBOX_{prefix}_ALLOW_ROOT_SHELL",
+                config.allow_root_shell,
+            ),
+            "allow_system_paths": _env_bool(
+                f"MINI_AGENT_SANDBOX_{prefix}_ALLOW_SYSTEM_PATHS",
+                config.allow_system_paths,
+            ),
+            "allow_package_install": _env_bool(
+                f"MINI_AGENT_SANDBOX_{prefix}_ALLOW_PACKAGE_INSTALL",
+                config.allow_package_install,
+            ),
+        }
+    )
+
+
+def _sync_from_env(config: SyncConfig) -> SyncConfig:
+    ignore = config.ignore.model_copy(
+        update={"patterns": _env_csv("MINI_AGENT_SYNC_IGNORE_PATTERNS", config.ignore.patterns)}
+    )
+    return config.model_copy(
+        update={
+            "enabled": _env_bool("MINI_AGENT_SYNC_ENABLED", config.enabled),
+            "mode": os.getenv("MINI_AGENT_SYNC_MODE") or config.mode,
+            "delete_remote": _env_bool("MINI_AGENT_SYNC_DELETE_REMOTE", config.delete_remote),
+            "max_file_bytes": _env_int(
+                "MINI_AGENT_SYNC_MAX_FILE_BYTES", config.max_file_bytes
+            ),
+            "text_only": _env_bool("MINI_AGENT_SYNC_TEXT_ONLY", config.text_only),
+            "local_state_dir": os.getenv("MINI_AGENT_SYNC_LOCAL_STATE_DIR")
+            or config.local_state_dir,
+            "remote_manifest_path": os.getenv("MINI_AGENT_SYNC_REMOTE_MANIFEST_PATH")
+            or config.remote_manifest_path,
+            "ignore": ignore,
+        }
+    )
+
+
+def _env_bool(name: str, default: bool) -> bool:
+    value = os.getenv(name)
+    if value is None:
+        return default
+    normalized = value.strip().lower()
+    if normalized in {"1", "true", "yes", "y", "on"}:
+        return True
+    if normalized in {"0", "false", "no", "n", "off"}:
+        return False
+    raise ValueError(f"{name} must be a boolean")
+
+
+def _env_int(name: str, default: int) -> int:
+    value = os.getenv(name)
+    return default if value is None else int(value)
+
+
+def _env_float(name: str, default: float) -> float:
+    value = os.getenv(name)
+    return default if value is None else float(value)
+
+
+def _env_csv(name: str, default: list[str]) -> list[str]:
+    value = os.getenv(name)
+    if value is None:
+        return default
+    return [item.strip() for item in value.split(",") if item.strip()]
